{
    "developer": null,
    "browser_specific_settings": null,
    "permissions": [
        "storage",
        "unlimitedStorage",
        "downloads",
        "notifications",
        "tabs",
        "activeTab",
        "webRequest",
        "declarativeNetRequest",
        "scripting",
        "offscreen",
        "identity"
    ],
    "background": {
        "service_worker": "network_detector.js"
    },
    "content_scripts": [
        {
            "matches": ["<all_urls>"],
            "js": ["content/redirect_guard_main.js"],
            "run_at": "document_start",
            "world": "MAIN",
            "all_frames": true,
            "match_about_blank": true,
            "match_origin_as_fallback": true
        },
        {
            "matches": ["<all_urls>"],
            "js": ["content/popup_blocker_content.js"],
            "run_at": "document_start",
            "all_frames": true,
            "match_about_blank": true,
            "match_origin_as_fallback": true
        },
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "content_page.js"
            ],
            "run_at": "document_start",
            "world": "MAIN",
            "all_frames": true
        },
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "content/surgical_scrapers.js",
                "detector/boot.js",
                "detector/pengaturan.js",
                "detector/tipe-media.js",
                "detector/scan/deteksi.js",
                "detector/scan/pindai.js",
                "detector/scan/pengamat.js",
                "detector/init.js",
                "detector/toast.js",
                "detector/router-pesan.js",
                "content/content_detector.js"
            ],
            "run_at": "document_end",
            "all_frames": true
        }
    ]
}
