{
    "developer": null,
    "browser_specific_settings": null,
    "permissions": [
        "storage",
        "unlimitedStorage",
        "downloads",
        "notifications",
        "tabs",
        "activeTab",
        "webRequest",
        "declarativeNetRequest",
        "scripting",
        "offscreen",
        "identity"
    ],
    "background": {
        "service_worker": "network_detector.js"
    },
    "content_scripts": [
        {
            "matches": ["<all_urls>"],
            "js": ["redirect_guard_main.js"],
            "run_at": "document_start",
            "world": "MAIN",
            "all_frames": false
        },
        {
            "matches": ["<all_urls>"],
            "js": ["popup_blocker_content.js"],
            "run_at": "document_start",
            "all_frames": false
        },
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "content_page.js"
            ],
            "run_at": "document_start",
            "world": "MAIN",
            "all_frames": true
        },
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "surgical_scrapers.js",
                "content_detector.js"
            ],
            "run_at": "document_end",
            "all_frames": true
        },
        {
            "matches": [
                "*://*.youtube.com/embed/*"
            ],
            "js": [
                "libraries/wymd.js",
                "yt_core.js"
            ],
            "run_at": "document_end",
            "all_frames": true
        },
        {
            "matches": [
                "*://*.youtube.com/*"
            ],
            "exclude_matches": [
                "*://*.youtube.com/embed/*"
            ],
            "js": [
                "libraries/wymd.js",
                "yt_core.js"
            ],
            "run_at": "document_end",
            "all_frames": false
        }
    ]
}
