{
    "name": "Website Media Downloader",
    "manifest_version": 3,
    "version": "2.6.0",
    "description": "__MSG_extensionDescription__",
    "author": "anpa26",
    "developer": {
        "name": "anpa26",
        "url": "https://github.com/anpa26"
    },
    "browser_specific_settings": {
        "gecko": {
            "id": "{924f7c81-8b1e-4b6e-9e7c-8e4a9e1d2c3f}",
            "update_url": "https://raw.githubusercontent.com/anpa26/website-media-downloader/wmd-1/updates.json",
            "data_collection_permissions": {
                "required": [
                    "none"
                ]
            }
        }
    },
    "content_security_policy": {
        "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
    },
    "permissions": [
        "storage",
        "unlimitedStorage",
        "downloads",
        "notifications",
        "tabs",
        "activeTab",
        "webRequest",
        "webRequestBlocking",
        "webRequestFilterResponse",
        "scripting",
        "offscreen",
        "identity"
    ],
    "oauth2": {
        "client_id": "1042907477337-c8h27qniercjia05jqqafgvjao514n28.apps.googleusercontent.com",
        "scopes": [
            "https://www.googleapis.com/auth/drive.file"
        ]
    },
    "optional_permissions": [],
    "host_permissions": [
        "<all_urls>"
    ],
    "homepage_url": "https://github.com/anpa26/website-media-downloader",
    "background": {
        "service_worker": "network_detector.js",
        "scripts": [
            "lib/debug_logger.js",
            "lib/detection_exclusions.js",
            "lib/media_filename.js",
            "libraries/wymd.js",
            "background/popup_blocker.js",
            "background/stream_jobs.js",
            "background/download_recovery.js",
            "background/boot.js",
            "background/detection/m3u8-youtube.js",
            "background/jobs/persistent-jobs.js",
            "background/cache/cache-db.js",
            "background/detection/media-types.js",
            "background/detection/headers.js",
            "background/settings.js",
            "background/ui/toast.js",
            "background/ui/notifikasi.js",
            "background/jobs/history.js",
            "background/jobs/autodownload.js",
            "background/detection/listeners.js",
            "background/audio/audio.js",
            "background/audio/audio-base.js",
            "background/router.js",
            "background/download/zip.js",
            "background/download/fetch-core.js",
            "background/cloud/cloud-upload.js",
            "background/cloud/cloud-save.js",
            "background/cloud/cloud-paralel.js",
            "background/cloud/cloud-auth.js",
            "background/cloud/cloud-stream.js",
            "background/download/fetch-download.js",
            "background/init.js",
            "background/cache/cache.js",
            "network_detector.js"
        ]
    },
    "content_scripts": [
        {
            "matches": ["<all_urls>"],
            "js": ["content/redirect_guard_main.js"],
            "run_at": "document_start",
            "world": "MAIN",
            "all_frames": true,
            "match_about_blank": true,
            "match_origin_as_fallback": true
        },
        {
            "matches": ["<all_urls>"],
            "js": ["content/popup_blocker_content.js"],
            "run_at": "document_start",
            "all_frames": true,
            "match_about_blank": true,
            "match_origin_as_fallback": true
        },
        {
            "matches": [
                "<all_urls>"
            ],
            "css": [
                "styles/content-toast.css"
            ],
            "js": [
                "content/surgical_scrapers.js",
                "lib/media_compute_client.js",
                "lib/media_filename.js",
                "entries/offlineStreamConvert.js",
                "converter/util.js",
                "converter/cache/cache-db.js",
                "converter/segmen.js",
                "converter/mux/transmux.js",
                "converter/spoof.js",
                "converter/cache/cache-media.js",
                "converter/antrean.js",
                "converter/cloud/cloud-stream.js",
                "converter/cloud/cloud-auth.js",
                "converter/cloud/cloud-upload.js",
                "converter/media-types.js",
                "converter/finalize.js",
                "converter/audio.js",
                "converter/m3u8/m3u8-varian.js",
                "converter/m3u8/m3u8-unduh.js",
                "converter/mux/gabung-mp4.js",
                "converter/mpd/mpd.js",
                "converter/mpd/pilih-mpd.js",
                "converter/progress.js",
                "converter/youtube/youtube-mux.js",
                "converter/youtube/youtube-chunk.js",
                "converter/youtube/youtube-vtt.js",
                "converter/youtube/youtube-subtitle.js",
                "detector/boot.js",
                "detector/pengaturan.js",
                "detector/tipe-media.js",
                "detector/scan/deteksi.js",
                "detector/scan/pindai.js",
                "detector/scan/pengamat.js",
                "detector/init.js",
                "detector/toast.js",
                "detector/router-pesan.js",
                "content/content_detector.js"
            ],
            "run_at": "document_end"
        },
        {
            "matches": [
                "*://*.youtube.com/embed/*"
            ],
            "js": [
                "libraries/wymd.js",
                "content/yt_core.js"
            ],
            "run_at": "document_end",
            "all_frames": true
        },
        {
            "matches": [
                "*://*.youtube.com/*"
            ],
            "exclude_matches": [
                "*://*.youtube.com/embed/*"
            ],
            "js": [
                "libraries/wymd.js",
                "content/yt_core.js"
            ],
            "run_at": "document_end",
            "all_frames": false
        }
    ],
    "icons": {
        "96": "icons/icon.png",
        "128": "icons/icon.png"
    },
    "action": {
        "default_title": "__MSG_actionTitle__"
    },
    "web_accessible_resources": [{
        "resources": [
            "workers/media_compute_worker.js",
            "libraries/mux.js",
            "workers/mp4_duration.js",
            "libraries/client-zip.js",
            "libraries/subsrt.bundle.js",
            "libraries/libav.js"
        ],
        "matches": ["<all_urls>"]
    }],
    "default_locale": "en",
    "options_page": "pages/popup.html?options=true"
}
